{
  "name": "fnalabs_assets",
  "version": "0.0.0",
  "description": "FnA Labs logos and trademark [info](https://fnalabs.github.io/fnalabs-assets/).",
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production HOST=https://fnalabs.github.io/fnalabs-assets ROUTE=/assets rspack build",
    "build:storybook": "storybook build -o docs/storybook",
    "debug": "NODE_ENV=development HOST=http://localhost:2999 ROUTE=/assets FEDERATION_DEBUG=true rspack serve",
    "dev": "NODE_ENV=development HOST=http://localhost:2999 ROUTE=/assets rspack serve",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "test": "test-storybook --coverage && npm run test:format",
    "test:format": "nyc report --reporter=lcov -t coverage/storybook --report-dir coverage/storybook",
    "test:watch": "test-storybook --watchAll"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@module-federation/enhanced": "2.8.0",
    "react": "19.2.8",
    "react-cookie-consent": "10.0.1",
    "react-dom": "19.2.8",
    "react-ga4": "3.0.1",
    "react-router": "8.2.0"
  },
  "devDependencies": {
    "@aaroon/workbox-rspack-plugin": "1.0.1",
    "@eslint/js": "10.0.1",
    "@rsbuild/core": "2.1.7",
    "@rsbuild/plugin-react": "2.1.0",
    "@rspack/cli": "2.1.5",
    "@rspack/core": "2.1.5",
    "@rspack/dev-server": "2.1.0",
    "@rspack/plugin-react-refresh": "2.0.2",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/addon-coverage": "3.0.2",
    "@storybook/addon-docs": "10.5.3",
    "@storybook/addon-links": "10.5.3",
    "@storybook/addon-onboarding": "10.5.3",
    "@storybook/test-runner": "0.24.4",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "axe-playwright": "2.2.2",
    "bulma": "1.0.4",
    "eslint": "10.7.0",
    "eslint-plugin-storybook": "10.5.3",
    "globals": "17.7.0",
    "playwright": "1.61.1",
    "prettier": "3.9.6",
    "react-refresh": "0.18.0",
    "storybook": "10.5.3",
    "storybook-react-rsbuild": "3.3.4",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "type-fest": "5.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "volta": {
    "node": "24.18.0"
  }
}
