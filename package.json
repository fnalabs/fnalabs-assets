{
  "name": "fnalabs_assets",
  "version": "0.0.0",
  "description": "FnA Labs logos and trademark [info](https://fnalabs.github.io/fnalabs-assets/).",
  "scripts": {
    "build": "NODE_ENV=production HOST=https://fnalabs.github.io/fnalabs-assets ROUTE=/assets rspack build",
    "build:storybook": "storybook build",
    "dev": "NODE_ENV=development HOST=http://localhost:2999 ROUTE=/assets rspack serve",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "test": "test-storybook --coverage",
    "test:watch": "test-storybook --watchAll"
  },
  "author": "",
  "license": "MIT",
