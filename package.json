    "react-router": "7.13.2"
  },
  "devDependencies": {
    "@aaroon/workbox-rspack-plugin": "0.3.2",
    "@eslint/js": "9.39.4",
    "@rsbuild/core": "1.7.4",
    "@rsbuild/plugin-react": "1.4.6",
    "@rspack/cli": "1.7.10",
    "@rspack/core": "1.7.10",
    "@rspack/plugin-react-refresh": "1.6.1",
